+@pytest.mark.asyncio
+async def test_temporal_neighbors_adds_nothing_without_valid_at_or_on_other_providers():
+    history = [_home(1960)]
+    undated = _dated_edge('home ?', None)
+    dated = _dated_edge('home 1961', datetime(1961, 1, 1, tzinfo=timezone.utc))
+
+    assert await temporal_neighbors(_FakeNeighborDriver(history), undated, []) == []
