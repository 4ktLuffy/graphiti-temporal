+class _FakeNeighborDriver:
+    """Answers the neighbour queries from a list of edges, using only `>` and `IS NULL`.
+
+    That is all the patched query asks the database for; the rest must happen in Python.
+    """
+
+    def __init__(self, edges, provider=GraphProvider.NEO4J):
+        self.edges, self.provider, self.queries = edges, provider, []
+
+    async def execute_query(self, query, **params):
+        self.queries.append(query)
+        start, name, exclude = params['start'], params['name'], set(params['exclude'])
+        later = 'e.valid_at > $start' in query
+        rows = [
+            e
+            for e in self.edges
+            if e.uuid not in exclude
+            and (name is None or e.name == name)
+            and (e.valid_at > start if later else (e.invalid_at is None or e.invalid_at > start))
+        ]
+        rows.sort(key=lambda e: e.valid_at)
+        return rows[: params['limit']], None, None
+
+
+def _home(year, end_year=None, name='LIVES_IN'):
+    utc = timezone.utc
+    return _dated_edge(
+        f'home {year}',
+        datetime(year, 1, 1, tzinfo=utc),
+        datetime(end_year, 1, 1, tzinfo=utc) if end_year else None,
+    ).model_copy(update={'name': name})
+
+
+@pytest.mark.asyncio
+async def test_temporal_neighbors_returns_next_facts_and_the_fact_open_at_start(monkeypatch):
+    monkeypatch.setattr(
+        'graphiti_core.utils.maintenance.edge_operations.get_entity_edge_from_record',
+        lambda record, provider: record,
+    )
+    history = [_home(y, y + 2) for y in range(1950, 1980, 2)] + [_home(1980)]
+    new = _dated_edge('home 1961', datetime(1961, 1, 1, tzinfo=timezone.utc))
+
+    found = await temporal_neighbors(_FakeNeighborDriver(history), new, [])
+
+    assert [e.fact for e in found] == ['home 1962', 'home 1964', 'home 1966', 'home 1960']
+
+
+@pytest.mark.asyncio
+async def test_temporal_neighbors_skips_known_candidates_and_prefers_the_same_relation(monkeypatch):
+    monkeypatch.setattr(
+        'graphiti_core.utils.maintenance.edge_operations.get_entity_edge_from_record',
+        lambda record, provider: record,
+    )
+    job = _home(1970, name='WORKS_AT')
+    history = [_home(1960, 1962), _home(1962, 1964), _home(1964), job]
+    new = _dated_edge('home 1961', datetime(1961, 1, 1, tzinfo=timezone.utc))
+
+    found = await temporal_neighbors(_FakeNeighborDriver(history), new, [history[1]])
+
+    assert [e.fact for e in found] == ['home 1964', 'home 1960']  # 1962 already a candidate
+
