+
+async def _nearest_own_edges(
+    driver: GraphDriver,
+    edge: EntityEdge,
+    start: datetime,
+    later: bool,
+    exclude: list[str],
+    name: str | None,
+    limit: int,
+) -> list[EntityEdge]:
+    """The subject's facts starting after `start`, or open at `start`, nearest first.
+
+    Only `>` and `IS NULL` are used in the query. FalkorDB 4.x ignores the bound of a string `<`
+    or `<=` when a range index covers the property, so "started at or before `start`" is checked
+    here instead. Facts still open after `start` are read in start order, so those already open
+    at `start` come first; up to `OPEN_SCAN` of them are read.
+    """
+    where = 'e.valid_at > $start' if later else '(e.invalid_at IS NULL OR e.invalid_at > $start)'
+    if name is not None:
+        where += ' AND e.name = $name'
+    records, _, _ = await driver.execute_query(
+        """
+        MATCH (n:Entity {uuid: $source_uuid})-[e:RELATES_TO {group_id: $group_id}]->(m:Entity)
+        WHERE """
+        + where
+        + """ AND NOT e.uuid IN $exclude
+        RETURN """
+        + get_entity_edge_return_query(driver.provider)
+        + """
+        ORDER BY e.valid_at ASC
+        LIMIT $limit
+        """,
+        source_uuid=edge.source_node_uuid,
+        group_id=edge.group_id,
+        start=start,
+        name=name,
+        exclude=exclude,
+        limit=limit if later else OPEN_SCAN,
+        routing_='r',
+    )
+    edges = [get_entity_edge_from_record(record, driver.provider) for record in records]
+    if later:
+        return edges
+    open_at_start = [e for e in edges if e.valid_at is not None and ensure_utc(e.valid_at) <= start]
+    return open_at_start[::-1][:limit]
+
+
+async def temporal_neighbors(
+    driver: GraphDriver,
+    extracted_edge: EntityEdge,
+    candidates: list[EntityEdge],
+    limit: int = TEMPORAL_NEIGHBORS,
+) -> list[EntityEdge]:
+    """The subject's facts nearest in time to the edge being resolved, if search missed them.
+
+    A back-filled fact must be ended by the earliest later fact of the same kind, and may end a
+    fact still open at its start. Ranked search can miss both once the subject has more relevant
+    facts than the result limit, so the `limit` nearest on each side are added from the subject's
+    own facts, preferring facts with the same relation name. Without `valid_at` nothing is added.
+    Only Neo4j and FalkorDB are queried; other providers add nothing.
+    """
+    if extracted_edge.valid_at is None or driver.provider not in (
+        GraphProvider.NEO4J,
+        GraphProvider.FALKORDB,
+    ):
+        return []
+    start = ensure_utc(extracted_edge.valid_at)
+    assert start is not None
+    exclude = [e.uuid for e in candidates] + [extracted_edge.uuid]
+    for name in (extracted_edge.name, None):
+        found = [
+            *await _nearest_own_edges(driver, extracted_edge, start, True, exclude, name, limit),
+            *await _nearest_own_edges(driver, extracted_edge, start, False, exclude, name, limit),
+        ]
+        if found:
+            return found
+    return []
+
